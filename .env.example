# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Email Configuration (for sending digests)
# Generate app password here: https://myaccount.google.com/apppasswords
MY_EMAIL=
APP_PASSWORD=

# Database Configuration
# These are automatically set by Render when using PostgreSQL
# For local development, set USE_SQLITE=true
USE_SQLITE=false

# PostgreSQL (automatically provided by Render)
# POSTGRES_HOST - set automatically
# POSTGRES_PORT - set automatically
# POSTGRES_USER - set automatically
# POSTGRES_PASSWORD - set automatically
POSTGRES_DB=ai_news_aggregator
